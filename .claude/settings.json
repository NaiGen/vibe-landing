{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check-brief)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dlx shadcn@*)",
      "Bash(pnpm dlx shadcn *)",
      "Bash(pnpm dlx knip@*)",
      "Bash(node scripts/*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(curl *localhost:3000*)",
      "Bash(npx vercel:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/typecheck-hook.mjs\"" }
        ]
      }
    ]
  }
}
