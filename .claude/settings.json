{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm -v)",
      "Bash(node -v)",
      "Bash(corepack enable pnpm)",
      "Bash(npm install -g pnpm)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm check-brief)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dlx shadcn@*)",
      "Bash(pnpm dlx shadcn *)",
      "Bash(node scripts/*)",
      "Bash(git add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(curl *localhost:*)",
      "Bash(curl *https://*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/typecheck-hook.mjs\"" }
        ]
      }
    ]
  }
}
